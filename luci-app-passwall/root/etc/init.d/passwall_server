#!/bin/sh /etc/rc.common

START=99
SERVICE=/usr/libexec/passwall/service.uc

boot() {
	/usr/bin/ucode "$SERVICE" server boot >/dev/null 2>&1 &
}

start() {
	/usr/bin/ucode "$SERVICE" server start
}

stop() {
	/usr/bin/ucode "$SERVICE" server stop
}

restart() {
	/usr/bin/ucode "$SERVICE" server restart
}

reload() {
	/usr/bin/ucode "$SERVICE" server reload
}
