#!/bin/sh /etc/rc.common

START=99
STOP=15

ROOT="${IPKG_INSTROOT:-}"
SERVICE="$ROOT/usr/libexec/passwall/service.uc"

boot() {
	/usr/bin/ucode "$SERVICE" client boot >/dev/null 2>&1 &
}

start() {
	/usr/bin/ucode "$SERVICE" client start "$1" "$2"
}

stop() {
	/usr/bin/ucode "$SERVICE" client stop "$1" "$2"
}

restart() {
	/usr/bin/ucode "$SERVICE" client restart "$1" "$2"
}

reload() {
	/usr/bin/ucode "$SERVICE" client reload "$1" "$2"
}
