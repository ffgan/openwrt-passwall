{
	"luci-app-passwall": {
		"description": "Grant UCI, file and ubus access for luci-app-passwall",
		"read": {
			"ubus": {
				"file": [ "list", "read", "stat", "exec" ],
				"luci": [ "getFeatures" ],
				"luci-rpc": [ "getNetworkDevices", "getHostHints", "getDHCPLeases" ],
				"luci.passwall": [ "*" ],
				"network.interface": [ "dump" ]
			},
			"uci": [ "passwall", "passwall_server", "network", "dhcp", "firewall" ],
			"file": {
				"/etc/hosts": [ "read" ],
				"/etc/passwall/*": [ "read" ],
				"/etc/config/ssl/*": [ "read" ],
				"/etc/ssl/*": [ "read" ],
				"/usr/share/passwall/*": [ "read" ],
				"/usr/share/v2ray/*": [ "read" ],
				"/tmp/log/passwall.log": [ "read" ],
				"/tmp/log/passwall_server.log": [ "read" ],
				"/tmp/etc/passwall/*": [ "read" ],
				"/tmp/etc/passwall_server/*": [ "read" ],
				"/tmp/etc/passwall_tmp/*": [ "read" ],
				"/tmp/bak_v2ray/*": [ "read" ],
				"/tmp/dhcp.leases": [ "read" ],
				"/proc/net/arp": [ "read" ]
			}
		},
		"write": {
			"ubus": {
				"file": [ "write", "remove" ],
				"luci.passwall": [ "*" ]
			},
			"uci": [ "passwall", "passwall_server" ],
			"file": {
				"/etc/hosts": [ "write" ],
				"/etc/passwall/*": [ "write" ],
				"/etc/config/ssl/*": [ "write" ],
				"/tmp/log/passwall.log": [ "write" ],
				"/tmp/log/passwall_server.log": [ "write" ],
				"/tmp/links.conf": [ "write" ],
				"/tmp/etc/passwall_tmp/*": [ "write" ]
			}
		}
	}
}
