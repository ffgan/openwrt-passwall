		args: { id: 'string' },
		call: function(req) {
			return get_shunt_rules(req);
		}
	},
	add_shunt_rule: {
		args: { add_name: 'string', redirect: 'string', group: 'string' },
		call: function(req) {
			return add_shunt_rule(req);
		}
	},
	delete_select_shunt_rules: {
		args: { ids: 'string', redirect: 'string' },
		call: function(req) {
			return delete_select_shunt_rules(req);
		}
	},
	read_rulelist: {
		args: { type: 'string' },
		call: function(req) {
			return read_rulelist(req);
		}
	},
	app_check: {
		call: function() {
			return do_app_check();
		}
	},
	app_update: {
		args: app_update_args(),
		call: function(req) {
			return do_app_update(req);
		}
	},
	com_check: {
		args: { com: 'string' },
		call: function(req) {
			let name = form_raw(req, 'com');
			if (name == null)
				name = '';
			return do_com_check(name);
		}
	},
	com_update: {
		args: {
			com: 'string',
			task: 'string',
			id: 'string',
			total_size: 'string',
			file: 'string',
			subfix: 'string',
			url: 'string',
			size: 'string'
		},
		call: function(req) {
			let name = form_raw(req, 'com');
			if (name == null)
				name = '';
			return do_com_update(name, req);
		}
	},
	com_version: {
		args: { com: 'string' },
		call: function(req) {
			let name = form_raw(req, 'com');
			if (name == null)
				name = '';
			return do_com_version(name);
		}
	},
	create_backup: {
		call: function() {
			return create_backup();
		}
	},
	restore_backup: {
		args: {
			type: 'string',
			filename: 'string',
			chunk: 'string',
			chunk_index: 'string',
			total_chunks: 'string'
		},
		call: function(req) {
			return restore_backup(req);
		}
	},
	reset_config: {
		args: { type: 'string' },
		call: function(req) {
			return reset_config(req);
		}
	},
	geo_view: {
		args: { action: 'string', value: 'string' },
		call: function(req) {
			return geo_view(req);
		}
	},
	fetch_certsha256: {
		args: { id: 'string' },
		call: function(req) {
			return fetch_certsha256(req);
		}
	},
	gen_wireguard_key: {
		call: function() {
			return gen_wireguard_keypair();
		}
	},
	server_update_config: {
		args: { id: 'string', data: 'string' },
		call: function(req) {
			return server_update_config(req);
		}
	},
	server_status: {
		args: { index: 'string', id: 'string' },
		call: function(req) {
			return server_status(req);
		}
	},
	server_log: {
		args: { id: 'string' },
		call: function(req) {
			return server_log(req);
		}
	},
	server_get_log: {
		call: function() {
			return server_get_log();
		}
	},
	server_clear_log: {
		call: function() {
			return server_clear_log();
		}
	}
};

methods.show = methods.show_menu;
methods.hide = methods.hide_menu;
methods['check_' + app_name()] = methods.app_check;
methods['update_' + app_name()] = methods.app_update;

let order = com_order();
for (let i = 0; i < length(order); i++) {
	let name = order[i];
	methods['check_' + name] = {
		call: make_check(name)
	};
	methods['update_' + name] = {
		args: com_update_args(),
		call: make_update(name)
	};
	methods['version_' + name] = {
		call: make_version(name)
	};
}

return methods;
